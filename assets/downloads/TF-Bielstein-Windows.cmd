@echo off
title TF Bielstein
powershell -NoProfile -Command "Add-Type -AssemblyName System.Windows.Forms; $pick = New-Object System.Windows.Forms.FolderBrowserDialog; $pick.Description = 'Lokalen TFB-Websiteordner mit index.html auswaehlen'; if ($pick.ShowDialog() -ne 'OK') { exit }; $page = Join-Path $pick.SelectedPath 'index.html'; if (!(Test-Path $page)) { [System.Windows.Forms.MessageBox]::Show('In diesem Ordner fehlt index.html.', 'TF Bielstein'); exit 1 }; $browser = @((Join-Path $env:LOCALAPPDATA 'Google\Chrome\Application\chrome.exe'), (Join-Path $env:ProgramFiles 'Google\Chrome\Application\chrome.exe'), (Join-Path ${env:ProgramFiles(x86)} 'Google\Chrome\Application\chrome.exe'), (Join-Path ${env:ProgramFiles(x86)} 'Microsoft\Edge\Application\msedge.exe'), (Join-Path $env:ProgramFiles 'Microsoft\Edge\Application\msedge.exe')) | Where-Object { Test-Path $_ } | Select-Object -First 1; if (!$browser) { [System.Windows.Forms.MessageBox]::Show('Bitte Chrome oder Edge installieren.', 'TF Bielstein'); exit 1 }; $shell = New-Object -ComObject WScript.Shell; $shortcut = $shell.CreateShortcut((Join-Path ([Environment]::GetFolderPath('Desktop')) 'TF Bielstein.lnk')); $shortcut.TargetPath = $browser; $shortcut.Arguments = '--app=\"' + ([Uri]$page).AbsoluteUri + '#home\" --window-size=1440,980'; $shortcut.WorkingDirectory = $pick.SelectedPath; $icon = Join-Path $pick.SelectedPath 'assets\icons\icon.ico'; if (Test-Path $icon) { $shortcut.IconLocation = $icon }; $shortcut.Save(); [System.Windows.Forms.MessageBox]::Show('TF Bielstein liegt jetzt auf deinem Desktop.', 'TF Bielstein')"
